{
  "name": "cad-dualmode-smart-recognition",
  "productName": "CAD双模式智能识图",
  "version": "3.0.0",
  "description": "CAD 双模式智能识图 v3.0（参数化草图 / AI 建模 / AI 3D）",
  "main": "main.js",
  "author": "CAD Dual-Mode Team",
  "license": "MIT",
  "scripts": {
    "start": "electron .",
    "pack": "electron-builder --dir",
    "dist": "electron-builder --win portable"
  },
  "build": {
    "appId": "com.cad.dualmode",
    "productName": "CAD-DualMode-SmartRecognition",
    "directories": {
      "output": "dist",
      "buildResources": "build"
    },
    "files": [
      "main.js",
      "preload.js",
      "package.json"
    ],
    "extraResources": [
      {
        "from": "backend",
        "to": "backend"
      }
    ],
    "win": {
      "target": [
        {
          "target": "portable",
          "arch": [
            "x64"
          ]
        }
      ],
      "artifactName": "CAD双模式智能识图_v3.0.exe",
      "icon": "build/icon.ico"
    },
    "portable": {
      "artifactName": "CAD双模式智能识图_v3.0.exe",
      "unicode": true
    },
    "compression": "normal",
    "artifactName": "CAD双模式智能识图_v3.0.exe"
  },
  "devDependencies": {
    "electron": "^28.3.3",
    "electron-builder": "^26.0.12"
  }
}
